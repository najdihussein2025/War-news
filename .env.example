# ============================================================================
# Required secrets — set per machine, never commit real values
# ============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
CNRS_API_KEY=
CNRS_WEBHOOK_SECRET=
OLLAMA_API_KEY=
AIR_VIOLATION_WEBHOOK_SECRET=replace-with-a-secure-secret
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_STRING=

# ============================================================================
# Per-environment — set per deployment stack (dev, staging, production)
# ============================================================================
POSTGRES_DB=war_news_dev
DATABASE_URL=postgresql+psycopg2://postgres:change-me@db:5432/war_news_dev
POSTGRES_HOST_PORT=5432
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=5173
COMPOSE_PROJECT_NAME=war-news

OLLAMA_BASE_URL=http://192.168.40.25:11435/ollama
CNRS_API_BASE_URL=https://lebanon.cnrs.edu.lb/api/v1/llm-filtered-posts
AIR_VIOLATION_WEBHOOK_URL=http://localhost:8000/webhooks/air-violations
VITE_API_BASE_URL=/api
REDIS_URL=redis://redis:6379/0

# Feature toggles that differ between .env.main and .env.dev
SUMMARY_FLOW_MODE=off
SUMMARY_CROSSCHECK_ENABLED=false

# ============================================================================
# Per-service (set in docker-compose environment:, not here) — for reference only
# ============================================================================
# PG_APPLICATION_NAME=war-news-backend      # set per container in compose
# PIPELINE_ROLE=api                          # set per container in compose
# WATCHFILES_FORCE_POLLING=true              # backend only, dev reload
# PYTHONUNBUFFERED=1                         # workers only, logging

# ============================================================================
# Optional tuning overrides — all have defaults in app/core/config.py
# Uncomment and adjust if you need to override the default behavior
# ============================================================================

# --- Red Alert Telegram collector ---
# RED_ALERT_ENABLED=false
# RED_ALERT_DELIVERY_METHOD=public_preview
# RED_ALERT_CHANNEL_USERNAME=redlinkleb
# RED_ALERT_FETCH_LIMIT=500
# RED_ALERT_POLL_SECONDS=10
# RED_ALERT_REQUEST_TIMEOUT_SECONDS=30
# RED_ALERT_OCR_ENABLED=true

# --- LLM — Ollama ---
# OLLAMA_MODEL=gpt-oss:20b
# OLLAMA_TIMEOUT_SECONDS=90
# OLLAMA_NUM_CTX=
# OLLAMA_KEEP_ALIVE=
# OLLAMA_MAX_CONCURRENT_REQUESTS=6
# LLM_CONNECT_TIMEOUT_SECONDS=5
# LLM_HEALTH_RECHECK_SECONDS=30

# --- Relevance classification ---
# CNRS_LOOKBACK_HOURS=72
# RELEVANCE_OLLAMA_MODEL=gpt-oss:20b
# RELEVANCE_LLM_BATCH_SIZE=4
# RELEVANCE_LLM_TIMEOUT_SECONDS=240
# RELEVANCE_CLASSIFIER_BACKEND=local_llm
# RELEVANCE_CLASSIFIER_MAX_RETRIES=3
# RELEVANCE_CLASSIFIER_RETRY_BACKOFF_SECONDS=1.0

# --- Extraction (Tier 1 + Tier 2) ---
# EXTRACTION_OLLAMA_MODEL=qwen2.5:7b
# EXTRACTION_LLM_TIMEOUT_SECONDS=240
# EXTRACTION_LLM_MAX_CONCURRENT_REQUESTS=4
# EXTRACTION_LLM_REQUEST_RETRIES=2
# EXTRACTION_LLM_RETRY_BACKOFF_SECONDS=2.0
# TIER1_LLM_MAX_CONCURRENT_REQUESTS=2
# TIER2_LLM_MAX_CONCURRENT_REQUESTS=2
# TIER1_USE_COMBINED_PRESENCE_EXTRACTION=false
# TIER2_USE_BATCHED_CATEGORY_DETAIL=false
# TIER1_SPLIT_PHASES_ENABLED=false
# TIER1_SPLIT_MAX_SEGMENTS=10
# STORY_REVISION_LLM_FALLBACK_ENABLED=false

# --- Pipeline and lane management ---
# FRESH_LANE_SHARE=0.5
# FRESH_LANE_WINDOW_MINUTES=60
# LIVE_SWEEP_SECONDS=60
# PIPELINE_MAX_ATTEMPTS=3
# INGESTION_POLL_INTERVAL_SECONDS=120
# POLL_INTERVAL_MINUTES=5
# PIPELINE_WORKER_POLL_SECONDS=2.0
# PIPELINE_CLAIM_LEASE_SECONDS=240
# RELEVANCE_CLAIM_LEASE_SECONDS=1800
# PIPELINE_STAGE_MAX_ROWS_PER_PASS=100
# PIPELINE_LLM_STAGE_MAX_ROWS_PER_PASS=4
# PIPELINE_CURSOR_GAP_ROW_THRESHOLD=500
# PIPELINE_CURSOR_STALE_MINUTES=30

# --- Login and authentication ---
# LOGIN_MAX_FAILED_ATTEMPTS=3
# LOGIN_LOCKOUT_MINUTES=5
# AUTH_COOKIE_SECURE=false
# AUTH_COOKIE_SAMESITE=lax

# --- Dedup and clustering (incident grouping) ---
# CLUSTER_TIME_WINDOW_MINUTES=30
# CLUSTER_SIMILARITY_THRESHOLD=0.78
# CLUSTER_REQUIRE_CONDITION_MATCH=true
# CLUSTERING_MAX_ROWS_PER_PASS=100
# FAST_DEDUP_TIME_WINDOW_MINUTES=120
# PRE_DEDUP_SIMILARITY_THRESHOLD=0.92
# PRE_DEDUP_WINDOW_HOURS=48
# PRE_DEDUP_CANDIDATE_NARROWING=same_source
# PRE_DEDUP_TIME_BUCKET_HOURS=6
# PRE_DEDUP_SWEEP_ROW_CAP=100
# DEDUP_TIME_WINDOW_DAYS=3
# DEDUP_HIGH_THRESHOLD=0.78
# DEDUP_LOW_THRESHOLD=0.50
# DEDUP_FASTPATH_LOOKUP_WINDOW_DAYS=7
# DEDUP_FASTPATH_GAP_NEAR_SECONDS=120
# DEDUP_FASTPATH_GAP_MID_SECONDS=1800
# DEDUP_FASTPATH_GAP_FAR_SECONDS=21600
# DEDUP_FASTPATH_TEXT_HIGH=0.80
# DEDUP_FASTPATH_TEXT_MID=0.65
# DEDUP_FASTPATH_TEXT_NEAR=0.38
# DEDUP_FASTPATH_EMBEDDING_HIGH=0.86
# DEDUP_FASTPATH_EMBEDDING_POSSIBLE=0.78
# DEDUP_FASTPATH_EVENT_TOKEN_OVERLAP_MIN=0.72
# FAST_PATH_EMBEDDING_WAIT_MINUTES=20
# DEDUP_CROSS_VILLAGE_TEXT_MIN=0.87
# SEGMENT_DEDUP_REVIEW_SIMILARITY_THRESHOLD=0.60
# SEGMENT_DEDUP_REVIEW_BALANCED_SCORE_THRESHOLD=0.60
# SEGMENT_DEDUP_REVIEW_WINDOW_DAYS=7
# SEGMENT_DEDUP_REVIEW_MAX_EVENT_GAP_HOURS=24
# SEGMENT_DEDUP_REVIEW_MIN_INFORMATIVE_TOKENS=4
# SEGMENT_DEDUP_REVIEW_MAX_CANDIDATES=20
# DUPLICATE_REVIEW_THRESHOLD=0.85
# DUPLICATE_AUTOLINK_THRESHOLD=0.98
# DUPLICATE_AUTOLINK_MAX_EVENT_GAP_HOURS=3.0

# --- Summary bulletin flow ---
# SUMMARY_RECONCILE_DELAY_MINUTES=90
# SUMMARY_RECONCILE_INTERVAL_SECONDS=300
# SUMMARY_MATCH_TOLERANCE_MINUTES=60
# SUMMARY_CROSSCHECK_MODEL=gpt-oss:20b
# SUMMARY_CROSSCHECK_TIMEOUT_SECONDS=120

# --- Bulletin reconciliation ---
# BULLETIN_RECONCILIATION_WINDOW_HOURS=60
# BULLETIN_RECONCILIATION_SWEEP_INTERVAL_SECONDS=1800
# BULLETIN_RECONCILIATION_VILLAGE_SET_MIN_OVERLAP=1.0

# --- Story continuation (Phase 1) ---
# STORY_CANDIDATE_WINDOW_HOURS=72
# STORY_CANDIDATE_EMBEDDING_THRESHOLD=0.40
# STORY_CANDIDATE_MAX_RESULTS=10

# --- Incident and village geo-context ---
# VILLAGE_GEO_CONTEXT_MAX_DISTANCE_METERS=15000
# VILLAGE_GEO_CONTEXT_MIN_DISTANCE_ADVANTAGE_METERS=5000
# EXTRACTION_MAX_RETRIES=5
# MATCHING_MAX_RETRIES=5

# --- Cache and feature toggles ---
# CACHE_ENABLED=true
# CASUALTY_FLAGS_ENABLED=false
# CASUALTY_FLAG_GRACE_MINUTES=120
# VITE_USE_POLLING=true
