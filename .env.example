POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=war_news_dev

DATABASE_URL=postgresql+psycopg2://postgres:change-me@db:5432/war_news_dev
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_STRING=
RED_ALERT_ENABLED=false
RED_ALERT_DELIVERY_METHOD=public_preview
RED_ALERT_CHANNEL_USERNAME=redlinkleb
RED_ALERT_FETCH_LIMIT=20
RED_ALERT_POLL_SECONDS=10
RED_ALERT_REQUEST_TIMEOUT_SECONDS=30
RED_ALERT_OCR_ENABLED=true
# Bearer token for https://lebanon.cnrs.edu.lb/api/v1/llm-filtered-posts; never commit a real value.
CNRS_API_KEY=
CNRS_API_BASE_URL=https://lebanon.cnrs.edu.lb/api/v1/llm-filtered-posts
CNRS_WEBHOOK_SECRET=

# Keep this at or below the OLLAMA_NUM_PARALLEL value configured on the Ollama server.
OLLAMA_BASE_URL=http://192.168.40.25:11435/ollama
OLLAMA_API_KEY=your-bearer-token-here
OLLAMA_MODEL=gpt-oss:20b
RELEVANCE_OLLAMA_MODEL=gpt-oss:20b
EXTRACTION_OLLAMA_MODEL=qwen2.5:7b
RELEVANCE_LLM_BATCH_SIZE=4
RELEVANCE_LLM_TIMEOUT_SECONDS=240
RELEVANCE_CLASSIFIER_BACKEND=cnrs_provided
OLLAMA_TIMEOUT_SECONDS=90
OLLAMA_MAX_CONCURRENT_REQUESTS=4

# Set by docker-compose per service. Do not run sweeps in the backend process.
PG_APPLICATION_NAME=war-news-backend
PIPELINE_ROLE=api

INGESTION_POLL_INTERVAL_SECONDS=120
POLL_INTERVAL_MINUTES=5
LOGIN_MAX_FAILED_ATTEMPTS=3
LOGIN_LOCKOUT_MINUTES=5

# Incoming air-violation webhook. Never put a real secret in this example file.
AIR_VIOLATION_WEBHOOK_ENABLED=false
AIR_VIOLATION_WEBHOOK_URL=http://localhost:8000/webhooks/air-violations
AIR_VIOLATION_WEBHOOK_TIMEOUT_SECONDS=10
AIR_VIOLATION_WEBHOOK_SECRET=replace-with-a-secure-secret
# Use true when the API is served over HTTPS in production.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
SUPER_ADMIN_SEED_PASSWORD=password

CLUSTER_TIME_WINDOW_MINUTES=90
CLUSTER_SIMILARITY_THRESHOLD=0.90
CLUSTER_REQUIRE_CONDITION_MATCH=true
FAST_DEDUP_TIME_WINDOW_MINUTES=120

VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://backend:8000

